{
  "name": "hopium-family",
  "private": true,
  "version": "1.0.0",
  "description": "hopium.family \u2014 social trading super-app (web + iOS + Android, one codebase)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @hopium/mobile",
    "web": "npm run web -w @hopium/mobile",
    "ios": "npm run ios -w @hopium/mobile",
    "android": "npm run android -w @hopium/mobile",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/mobile",
    "lint": "npm run lint -w @hopium/mobile && eslint --no-error-on-unmatched-pattern packages scripts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "export:web": "npm run export:web -w @hopium/mobile",
    "doctor": "npm run doctor -w @hopium/mobile",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run export:web",
    "icons": "tsx scripts/generate-icons.ts",
    "legal": "tsx scripts/build-legal.ts",
    "seed:sql": "tsx scripts/seed-demo.ts",
    "e2e:web": "playwright test",
    "e2e:mobile": "maestro test e2e/maestro/happy-path.yaml",
    "test:functions": "npx --yes deno@2 test --allow-env --allow-net=api.coingecko.com,api.hyperliquid.xyz --config supabase/functions/deno.json supabase/functions",
    "test:db": "bash scripts/test-db.sh"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/opentype.js": "^1.3.10",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15"
  }
}
